public class OopsBanner {
    public static void main(String[] args) {
        // 1. Define the banner as a String array
        // Each element represents one horizontal line of the "OOPS" text
        String[] banner = {
            "  ***    ***   ****   **** ",
            " *   *  *   *  *   *  *    ",
            " *   *  *   *  ****    *** ",
            " *   *  *   *  *          *",
            "  ***    ***   *      **** "
        };

        // 2. Use a loop to iterate through the array
        // 'row' takes the value of each String in the array one by one
        for (String row : banner) {
            System.out.println(row);
        }
    }
}
